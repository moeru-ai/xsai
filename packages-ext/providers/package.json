{
  "name": "@xsai-ext/providers",
  "type": "module",
  "version": "1.0.0-beta.7",
  "description": "extra-small AI SDK: provider routes, model capabilities, and costs from models.dev.",
  "author": "Moeru AI",
  "license": "MIT",
  "homepage": "https://xsai.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/xsai.git",
    "directory": "packages-ext/providers"
  },
  "bugs": "https://github.com/moeru-ai/xsai/issues",
  "keywords": [
    "xsai",
    "ai",
    "models.dev",
    "provider",
    "providers"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./text": "./src/text.ts",
    "./embed": "./src/embed.ts",
    "./image": "./src/image.ts",
    "./audio": "./src/audio.ts",
    "./decide": "./src/decide.ts",
    "./full": "./src/full.ts",
    "./*": "./src/providers/*.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./text": {
        "types": "./dist/text.d.ts",
        "default": "./dist/text.js"
      },
      "./embed": {
        "types": "./dist/embed.d.ts",
        "default": "./dist/embed.js"
      },
      "./image": {
        "types": "./dist/image.d.ts",
        "default": "./dist/image.js"
      },
      "./audio": {
        "types": "./dist/audio.d.ts",
        "default": "./dist/audio.js"
      },
      "./decide": {
        "types": "./dist/decide.d.ts",
        "default": "./dist/decide.js"
      },
      "./full": {
        "types": "./dist/full.d.ts",
        "default": "./dist/full.js"
      },
      "./*": {
        "types": "./dist/providers/*.d.ts",
        "default": "./dist/providers/*.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "pkgroll --clean-dist",
    "sync": "tsx scripts/sync.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@xsai/audio": "workspace:",
    "@xsai/decide": "workspace:",
    "@xsai/embed": "workspace:",
    "@xsai/image": "workspace:",
    "@xsai/text-chat": "workspace:",
    "@xsai/text-messages": "workspace:",
    "@xsai/text-responses": "workspace:"
  },
  "peerDependenciesMeta": {
    "@xsai/audio": {
      "optional": true
    },
    "@xsai/decide": {
      "optional": true
    },
    "@xsai/embed": {
      "optional": true
    },
    "@xsai/image": {
      "optional": true
    },
    "@xsai/text-chat": {
      "optional": true
    },
    "@xsai/text-messages": {
      "optional": true
    },
    "@xsai/text-responses": {
      "optional": true
    }
  },
  "devDependencies": {
    "@xsai/audio": "workspace:",
    "@xsai/decide": "workspace:",
    "@xsai/embed": "workspace:",
    "@xsai/image": "workspace:",
    "@xsai/text-chat": "workspace:",
    "@xsai/text-messages": "workspace:",
    "@xsai/text-responses": "workspace:"
  }
}

{
  "name": "@xsai/workspace",
  "type": "module",
  "version": "1.0.0-beta.1",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "repository": "github:moeru-ai/xsai",
  "scripts": {
    "build": "turbo build && pnpm docs:assemble",
    "build:docs": "turbo build --filter=@xsai/docs --filter=@xsai/docs-v0 && pnpm docs:assemble",
    "build:packages": "turbo build --filter=./packages/*",
    "bump": "bumpp",
    "dev:docs": "turbo dev --filter=@xsai/docs --filter=@xsai/docs-v0",
    "docs:assemble": "rm -rf docs/out && cp -R docs/.vitepress/dist docs/out && cp -R docs-v0/.vitepress/dist docs/out/v0",
    "docs:sync": "automd --input \"README.md,packages/*/README.md\"",
    "lint": "moeru-lint .",
    "preview:docs": "pnpm --filter @xsai/docs preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -b tsconfig.lib.json tsconfig.node.json"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@hey-api/openapi-ts": "catalog:",
    "@moeru/eslint-config": "catalog:",
    "@moeru/tsconfig": "catalog:",
    "@pnpm/find-workspace-dir": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "automd": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "oxlint": "catalog:",
    "pkg-pr-new": "catalog:",
    "pkgroll": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

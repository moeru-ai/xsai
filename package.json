{
  "name": "@xsai/workspace",
  "type": "module",
  "version": "0.5.1",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "repository": "github:moeru-ai/xsai",
  "scripts": {
    "build": "turbo build",
    "build:docs": "pnpm -F @xsai/docs build",
    "build:packages": "turbo -F=!./docs build",
    "bump": "bumpp",
    "dev:docs": "pnpm -F @xsai/docs dev",
    "lint": "moeru-lint .",
    "preview:docs": "pnpm -F @xsai/docs preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -b tsconfig.lib.json"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@hey-api/openapi-ts": "catalog:",
    "@moeru/eslint-config": "catalog:",
    "@moeru/tsconfig": "catalog:",
    "@pnpm/find-workspace-dir": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "automd": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "oxlint": "catalog:",
    "pkg-pr-new": "catalog:",
    "pkgroll": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

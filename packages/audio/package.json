{
  "name": "@xsai/audio",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "extra-small AI SDK: speech generation and transcription.",
  "author": "Moeru AI",
  "license": "MIT",
  "homepage": "https://xsai.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/xsai.git",
    "directory": "packages/audio"
  },
  "bugs": "https://github.com/moeru-ai/xsai/issues",
  "keywords": [
    "xsai",
    "ai",
    "openai",
    "speech",
    "tts",
    "transcription",
    "stt",
    "audio"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "pkgroll --clean-dist",
    "test": "vitest run --exclude e2e/**",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xsai/shared": "workspace:"
  }
}

{
  "name": "@xsai/decide",
  "type": "module",
  "version": "0.5.1",
  "description": "extra-small AI SDK: classify input by answering yes/no questions with probabilities.",
  "author": "Moeru AI",
  "license": "MIT",
  "homepage": "https://xsai.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/xsai.git",
    "directory": "packages/decide"
  },
  "bugs": "https://github.com/moeru-ai/xsai/issues",
  "keywords": [
    "xsai",
    "ai",
    "openai",
    "decide",
    "classification",
    "logprobs"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "pkgroll --clean-dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xsai/shared": "workspace:",
    "@xsai/text": "workspace:"
  }
}

{
  "name": "@xsai/embed",
  "type": "module",
  "version": "0.5.1",
  "description": "extra-small AI SDK: text embeddings.",
  "author": "Moeru AI",
  "license": "MIT",
  "homepage": "https://xsai.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/xsai.git",
    "directory": "packages/embed"
  },
  "bugs": "https://github.com/moeru-ai/xsai/issues",

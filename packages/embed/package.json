      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "pkgroll --clean-dist",
    "test": "vitest run --exclude e2e/**",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xsai/shared": "workspace:"
  }
}
